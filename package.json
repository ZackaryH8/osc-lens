{
  "name": "osc-lens",
  "displayName": "OSC Lens",
  "description": "Highlighting, completion, hover and diagnostics for OMSI 2 .osc scripts, varlists and constfiles - rules taken from reverse engineering of Omsi.exe.",
  "version": "0.1.0",
  "publisher": "zackaryh8",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "osc",
        "aliases": [
          "OMSI Script",
          "osc"
        ],
        "extensions": [
          ".osc"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "osc-constfile",
        "aliases": [
          "OMSI Constfile"
        ],
        "filenamePatterns": [
          "*constfile*.txt",
          "*Constfile*.txt",
          "*CONSTFILE*.txt",
          "*_const.txt",
          "*consts.txt"
        ]
      },
      {
        "id": "osc-varlist",
        "aliases": [
          "OMSI Varlist"
        ],
        "filenamePatterns": [
          "*varlist*.txt",
          "*Varlist*.txt",
          "*VARLIST*.txt"
        ]
      }
    ],
    "grammars": [
      {
        "language": "osc",
        "scopeName": "source.osc",
        "path": "./syntaxes/osc.tmLanguage.json"
      },
      {
        "language": "osc-constfile",
        "scopeName": "source.osc-constfile",
        "path": "./syntaxes/osc-constfile.tmLanguage.json"
      },
      {
        "language": "osc-varlist",
        "scopeName": "source.osc-varlist",
        "path": "./syntaxes/osc-varlist.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "OSC Lens",
      "properties": {
        "oscLens.omsiPath": {
          "type": "string",
          "default": "",
          "description": "OMSI 2 install folder. Used to load program/varlist_roadvehicle.txt and callbacklist_roadvehicle.txt so undeclared-variable checks are exact."
        },
        "oscLens.stackAnalysis": {
          "type": "boolean",
          "default": false,
          "description": "Experimental stack-depth checks right after an entry header. Assumes stores peek (unproven)."
        },
        "oscLens.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Diagnostic codes to hide, e.g. stray-endif."
        }
      }
    }
  },
  "scripts": {
    "check": "node scripts/check-language-data.mjs",
    "compile": "tsc -p .",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run check && tsc -p . && node --test out/test/*.test.js",
    "package": "npm run build && npm run smoke && vsce package --no-dependencies"
  },
  "dependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85",
    "typescript": "^5.9.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "main": "./out/client.js",
  "activationEvents": [
    "onLanguage:osc",
    "workspaceContains:**/*.bus",
    "workspaceContains:**/*.ovh",
    "workspaceContains:**/*.sco",
    "onLanguage:osc-constfile",
    "onLanguage:osc-varlist"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0",
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^3.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "ZackaryH8"
  },
  "icon": "images/icon.png",
  "homepage": "https://github.com/ZackaryH8/OMSI.MP/tree/master/osc-lens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZackaryH8/OMSI.MP.git",
    "directory": "osc-lens"
  },
  "bugs": {
    "url": "https://github.com/ZackaryH8/OMSI.MP/issues"
  },
  "keywords": [
    "omsi",
    "omsi 2",
    "osc",
    "bus simulator",
    "script",
    "linter",
    "language server"
  ],
  "galleryBanner": {
    "color": "#0d1526",
    "theme": "dark"
  }
}
